# === DeepSeek 摘要 + 复核 ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === 微信公众号 ===
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_AUTHOR=小编
WECHAT_MP_THUMB_MEDIA_ID=
# 本地封面须为足够大的 JPEG/PNG（建议宽≥900）；过小会触发微信 53402 封面裁剪失败
WECHAT_MP_THUMB_LOCAL_PATH=

# === 数据 ===
DATA_DIR=./data
# true：run_once / run_search_flow 对缺 published_at 的检索命中抓落地页补全（与 pipeline._extract_published_at 同源）
SEARCH_ARTICLE_PAGE_BACKFILL=true
SEARCH_ARTICLE_PAGE_BACKFILL_MAX_CONCURRENT=4
SEARCH_ARTICLE_PAGE_FETCH_TIMEOUT_SEC=35
# 兼容旧集成脚本名
SEARCH_TEST_ARTICLE_PAGE_BACKFILL=true
# === 向量去重 / 事件聚类（简历演示推荐：本机免费，无需 KEY）===
# local：本机 sentence-transformers 加载 EMBEDDING_MODEL（默认 BAAI/bge-m3），首次需联网下权重
# http：OpenAI 兼容 /v1/embeddings，需 EMBEDDING_API_KEY
EMBEDDING_BACKEND=local
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-m3
# 仅 EMBEDDING_BACKEND=http 时需要
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DEDUPE_THRESHOLD=0.92
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_BATCH_SIZE=8
# true：run_once 批内用向量做「转载合并 + 同事件聚类」；false 沿用 topic_key 聚类
EMBEDDING_CLUSTER_ENABLED=false
EMBEDDING_REPRINT_THRESHOLD=0.9
EMBEDDING_EVENT_LINK_MIN=0.75

# ----- 阶段三：事件增强（run_once 必选） -----
# 留空 = JSON 模式：GDELT+向量扩搜直接写 articles.json / event_article_map.json，摘要见 <DATA_DIR>/event_enhancement_last_run.json
# 填写 postgresql+asyncpg://… = PG 模式：同步到 PostgreSQL + Alembic（见 V3/docs/数据库结构_事件增强.md）
EVENT_ENHANCEMENT_DATABASE_URL=
# 留空则使用仓库根目录 event_enhancement/config/expansion.yaml
EVENT_ENHANCEMENT_CONFIG_PATH=

# 落地页正文：优先 trafilatura，失败/过短回退原逻辑
TRAFILATURA_ENABLED=true
TRAFILATURA_MIN_CHARS=200

# 成稿主要为外文时，仅将事件级标题+摘要译成中文（article 仍存原文）
EVENT_TRANSLATE_SUMMARY_ENABLED=true

# ----- 阶段四：事件级中文通稿（DeepSeek；在阶段三之后写入 events.json 的 event_press_zh） -----
# true：run_once 在事件增强后自动为多源事件生成通稿（需 DEEPSEEK_API_KEY）
EVENT_AI_PRESS_ENABLED=false
# 至少关联多少篇 article 才调用模型（融合多源；建议 >=2）
EVENT_AI_PRESS_MIN_ARTICLES=2
# true：已有 event_press_zh 则跳过，避免重复扣费
EVENT_AI_PRESS_SKIP_IF_EXISTS=true
# 选文：默认 all_by_tier（同事件尽量多篇按来源排序，仅去重同 URL，与全文素材一致）；top_k_dedupe=最多 5 篇 + 转载近似去重
EVENT_AI_PRESS_SELECTION_MODE=all_by_tier
# all_by_tier 时最多带几篇进 prompt（1~60）
EVENT_AI_PRESS_MAX_ARTICLES_IN_PROMPT=20
# 单篇正文最大字符数：0=不截断，全文作素材（推荐与 all_by_tier 同用，保留事件增强意义）
EVENT_AI_PRESS_PER_ARTICLE_MAX_CHARS=0
# 整段 user prompt 最大字符：0=不截断
EVENT_AI_PRESS_MAX_USER_CHARS=0
# 粗估 token 超此值时自动缩短单篇（需 PER_ARTICLE>0 才生效）；0=关闭
EVENT_AI_PRESS_SOFT_TOKEN_BUDGET=0
# 通稿请求超时（秒），长上下文时可略增
EVENT_AI_PRESS_TIMEOUT_SEC=180

# ----- 阶段五：通稿质量控制 + 条件重写（阶段四成功后默认自动执行） -----
# false：只保留阶段四初稿，不写 QA 字段
QA_REWRITE_ENABLED=true
# score>=阈值且 hallucination=false 视为通过；否则在 QA_REWRITE_MAX_ROUNDS 内循环重写
QA_REWRITE_PASS_THRESHOLD=80
QA_REWRITE_MAX_ROUNDS=2
QA_REWRITE_QA_TIMEOUT_SEC=120
QA_REWRITE_REWRITE_TIMEOUT_SEC=180
QA_REWRITE_MAX_EVENT_CHARS=120000
QA_REWRITE_MAX_RETRIES=3
QA_REWRITE_RETRY_BACKOFF_SEC=1.6

SCHEDULE_ENABLED=false
SCHEDULE_TIMEZONE=Asia/Shanghai
SCHEDULE_MORNING_HOUR=8
SCHEDULE_EVENING_HOUR=20
# 定时任务列表与时区：优先由 config/schedule_jobs.json 管理（平台「采集配置」可增删改）
# MAX_ARTICLE_AGE_HOURS 可由平台按「小时/天」自定义（上限约 365 天），保存时同步写入本文件

# === 检索：RSS 聚合（data_sources.json） + GDELT DOC ===
# 唯一词表：chinese_keywords / english_keywords；data_sources 每行 language=zh|en 决定 RSS 用哪套词过滤
# 主链路 GDELT 优先用 search_keywords.json 内 gdelt_english_keywords（6 词）；缺省则与 english_keywords 相同
# 联调缩表：仅改 gdelt_english_keywords；RSS 仍可用完整 english_keywords
SEARCH_KEYWORDS_PATH=config/search_keywords.json
SEARCH_QUERIES=低空经济,无人机,eVTOL
# 已弃用（保留兼容）：原 Google/DDGS 回退，现主链路为 RSS+GDELT
NEWS_SEARCH_FALLBACK=off

RSS_AGGREGATE_ENABLED=true
RSS_PER_FEED_MAX=30
# 合并 RSS + 栏目页 HTML 后的去重池上限；栏目源较多时建议 ≥500，避免尾部源（如企业站）被截断
RSS_TOTAL_MAX=500
RSS_TIMEOUT_SEC=25
# 栏目页 html_list 单站 GET 超时（原硬编码 60s）
HTML_LIST_TIMEOUT_SEC=20
# GDELT 命中在抓正文前的标题+摘要过滤
SEARCH_PREFILTER_ENABLED=true
# 簇摘要+QA 并行度（DeepSeek 限速；推送微信时 pipeline 强制为 1）
DEEPSEEK_CLUSTER_CONCURRENCY=3
CLUSTER_SUMMARY_MIN_CHARS=800
CLUSTER_SUMMARY_MAX_CHARS=1500
# true：RSS 条目须在 title+snippet 中命中对应语言关键词之一
RSS_RELEVANCE_FILTER_ENABLED=true
# true：RSS 对「标题+摘要」过滤；栏目页（html_list）仅对「标题」过滤（词表同 chinese_keywords / english_keywords，按站点 language）

GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_TIMEOUT_SEC=45
# 主链路 GDELT 第 2、3 次重试的单次请求超时（秒）
GDELT_RETRY_TIMEOUT_SEC=15
# 推荐 1h（勿用 7d）；文章年龄由 filter_by_age 在本地过滤
GDELT_TIMESPAN=1h
# 联调可 30；生产 50
GDELT_MAX_RECORDS=50
# HTTP 失败/429/空体/非 JSON 时最多重试次数（退避 5s→10s→20s）
GDELT_MAX_RETRIES=3
# 磁盘缓存目录：<DATA_DIR>/cache/gdelt/，命中则跳过 API
GDELT_CACHE_TTL_MIN=30
# 主题级 GDELT：仅英文词表、一词一请求串行，降低 429（中文请走 RSS，勿开 GDELT_CHINESE_ENABLED）
GDELT_CHINESE_ENABLED=false
GDELT_MAX_CONCURRENT=1
# 生产建议 5；联调/验收可 6 以降低 429
GDELT_MIN_INTERVAL_SEC=5
GDELT_OR_MAX_TERMS_PER_QUERY=14
# true=恢复旧版 (query) domain:site 扇出（不推荐）
GDELT_SITE_SCOPED_ENABLED=false

MAX_ARTICLE_AGE_HOURS=14
# 原文时间仅到「日历日」时：按 SCHEDULE_TIMEZONE 的日历与今天相差不超过 N 天则视为在窗内（与 MAX_ARTICLE_AGE_HOURS 的小时窗二选一）
DATE_ONLY_MAX_CALENDAR_AGE_DAYS=3
# 与 event_enhancement max_events_per_run 对齐；生产建议 8/10
MAX_PUBLISH_PER_RUN=8
MAX_PUBLISH_PER_DAY=10

# RUN_PROFILE=production | test — 仅文档提示；关键组合见 expansion.yaml
# 主题聚类：同窗内「禁飞/禁售」等政策相关簇软合并的时间窗（小时）
CLUSTER_MERGE_HOURS=168

# === 发布控制 ===
# false=run-once 仅入库待抽检，不自动推公众号；确认后再用 push-today-drafts 手动推送
RUN_ONCE_PUSH_TO_WECHAT=false
# 摘要写入公众号草稿箱成功后，清空 articles.json 中对应条目的 extracted_text（默认 true）
STRIP_EXTRACTED_TEXT_AFTER_WECHAT_DRAFT=true
# 按 importance 仅摘要/推送前 N 个事件；冷却期内已推过的 topic/标题跳过
WECHAT_PUBLISH_TOP_N=3
WECHAT_PUBLISH_COOLDOWN_DAYS=3
# DeepSeek 自动复核（规则门禁之后），不通过则直接拦截
SUMMARY_QA_ENABLED=true
SUMMARY_QA_MIN_SCORE=80

# === 大模型写作体例（非环境变量，仅说明）===
# 单篇摘要、多源簇摘要、事件通稿、QA system 的 Markdown 模板在 docs/prompts/；迭代改稿只改该目录下 .md，见 docs/prompts/README.md
