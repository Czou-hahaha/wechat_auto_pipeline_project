DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_AUTHOR=小编
WECHAT_MP_THUMB_MEDIA_ID=
WECHAT_MP_THUMB_LOCAL_PATH=

SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=Asia/Shanghai
SCHEDULE_MORNING_HOUR=8
SCHEDULE_EVENING_HOUR=20

SEARCH_QUERIES=低空经济,无人机,eVTOL
# 目标站点（逗号分隔域名）：每种搜索工具都会先按 site:domain 搜索，再做全域搜索补充
SEARCH_TARGET_SITES=gov.cn,ndrc.gov.cn,people.com.cn,news.cn,cctv.com
SEARCH_MAX_RESULTS=20
MAX_ARTICLE_AGE_HOURS=14
MAX_PUBLISH_PER_RUN=20
NEWS_SEARCH_FALLBACK=all

DATA_DIR=./data
LOG_LEVEL=INFO
